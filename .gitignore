# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# typescript
*.tsbuildinfo

# caches
.eslintcache
.prettiercache
.turbo
.cache

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem
certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and secrets (keep .env.example)
.env*
!.env.example
*.local
credentials.json

# vercel
.vercel

# sanity
.sanity
