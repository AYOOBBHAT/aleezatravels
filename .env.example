# Canonical public origin. Leave blank to use websiteUrl from lib/site-config.ts
# (https://aleezatravels.com). Set this only for preview deployments.
NEXT_PUBLIC_SITE_URL=

# Optional server-side overlays for public NAP. Prefer lib/site-config.ts.
# Do not copy public contact details into NEXT_PUBLIC_* unless a client bundle
# genuinely needs them. Mail credentials must never use NEXT_PUBLIC_.
BUSINESS_EMAIL=
BUSINESS_PHONE=
WHATSAPP_NUMBER=

# Optional public aliases if a value must be inlined into the client bundle.
# Do not put mail API keys here.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional public social profile URLs.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Server-only email delivery. Never prefix these with NEXT_PUBLIC_.
# When unset, validated enquiries are still offered as a WhatsApp message.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Local SEO / NAP. Leave blank until the real values are confirmed.
# You can also put the same values in lib/site-config.ts. Do not invent them.
BUSINESS_ADDRESS=
BUSINESS_CITY=
BUSINESS_DISTRICT=
BUSINESS_STATE=
BUSINESS_COUNTRY=
BUSINESS_POSTAL_CODE=
BUSINESS_LATITUDE=
BUSINESS_LONGITUDE=
BUSINESS_HOURS=
GOOGLE_MAPS_EMBED_URL=
GOOGLE_MAPS_PLACE_URL=

# Google Search Console HTML-tag verification token (content= value only).
GOOGLE_SITE_VERIFICATION=

# Analytics. Prefer GTM alone if you need both Analytics and other tags.
# Scripts load only when an ID is set. Do not set both unless GTM does not
# already load GA4.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sanity CMS. Project ID and dataset are public (Studio + CDN).
# Leave PROJECT_ID empty until the Sanity project exists — the site will
# keep serving local packages, destinations, and articles.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Server-only. Needed only if the dataset is private. Never use NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only shared secret for POST /api/revalidate (Sanity webhook).
SANITY_REVALIDATE_SECRET=
